<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <!--
    ProductVersion comes from the release tag (see .github/workflows/release.yml);
    it defaults to 0.0.0 so a local `candle` run still compiles. It has to change
    between releases or MajorUpgrade will not replace the installed build.
  -->
  <?ifndef ProductVersion ?>
  <?define ProductVersion = "0.0.0" ?>
  <?endif?>

  <Product
    Id="*"
    Name="Vidra"
    Language="1033"
    Version="$(var.ProductVersion)"
    Manufacturer="Vidra"
    UpgradeCode="A1B2C3D4-E5F6-47A1-9C3D-1234567890AB">

    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64"
      Description="Vidra $(var.ProductVersion) Setup"
      Comments="Vidra - Video Streaming App" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed."
      AllowDowngrades="no" />
    <MediaTemplate EmbedCab="yes" />

    <!-- ============ 🎨 使用自定义 UI ============ -->
    <UIRef Id="VidraUI" />

    <!-- 图标 -->
    <Icon Id="VidraIcon" SourceFile="assets\icon.ico" />

    <!-- Add/Remove Programs 条目 -->
    <Property Id="ARPPRODUCTICON" Value="VidraIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/heyvidra/VidraVideo" />
    <Property Id="ARPHELPLINK" Value="https://github.com/heyvidra/VidraVideo/issues" />
    <!-- The MSI has no repair story worth offering: it is a self-contained
         file copy, so reinstalling is the repair. -->
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- 目录结构 -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Vidra"/>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Vidra"/>
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop"/>
    </Directory>

    <!-- 功能 -->
    <Feature Id="MainFeature" Title="Vidra" Level="1">
      <ComponentGroupRef Id="VidraFiles"/>
      <ComponentRef Id="ApplicationShortcut"/>
      <ComponentRef Id="DesktopShortcut"/>
    </Feature>

    <!-- 快捷方式 -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="12345678-1234-1234-1234-123456789012">
        <Shortcut
          Id="ApplicationStartMenuShortcut"
          Name="Vidra"
          Description="Vidra - Video Streaming App"
          Target="[INSTALLFOLDER]vidra.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="VidraIcon"/>
        <Shortcut
          Id="UninstallProduct"
          Name="Uninstall Vidra"
          Target="[System64Folder]msiexec.exe"
          Arguments="/x [ProductCode]"
          Icon="VidraIcon"/>
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\Vidra" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="87654321-4321-4321-4321-210987654321">
        <Shortcut
          Id="ApplicationDesktopShortcut"
          Name="Vidra"
          Description="Vidra - Video Streaming App"
          Target="[INSTALLFOLDER]vidra.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="VidraIcon"/>
        <!-- No RemoveFolder here: the Desktop is the user's, not ours to delete.
             Uninstall drops the shortcut, which is all that was added. -->
        <RegistryValue Root="HKCU" Key="Software\Vidra" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

  </Product>

</Wix>
